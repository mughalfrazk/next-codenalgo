# Copy to .env.local and fill in to enable real contact-form email delivery.
# Without these set, the contact form still works — submissions are logged
# server-side and the user sees the success state, but no email is sent.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender (must be a domain/address verified in your Resend account).
CONTACT_FROM_EMAIL="Code & Algo <onboarding@resend.dev>"

# Where enquiry emails are delivered.
CONTACT_TO_EMAIL=info@codenalgo.com

# --- Firebase (admin panel + site settings) ---
# From Firebase Console > Project settings > General > Your apps (Web app).
# Public/client-side config — safe to expose, restricted by Firestore security rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
